{
  "name": "foodsave-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "FoodSave MVP: plataforma web para publicar y reservar productos próximos a vencer",
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:deploy": "npm run db:deploy -w apps/api",
    "seed": "npm run seed -w apps/api",
    "seed:test": "npm run seed:test -w apps/api",
    "lint": "eslint apps/api/src apps/web/src"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
