# FoodSave · variables de entorno (copiar a .env, que NO se versiona)
# Este archivo no lleva valores reales.

# Base de datos (PostgreSQL en Supabase)
DATABASE_URL=
DIRECT_URL=

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=

# Servidor de la API
PORT=
CORS_ORIGIN=

# Semillas: seed y seed:test solo se ejecutan si SEED_ALLOW_RESET=true
SEED_PASSWORD=
SEED_ALLOW_RESET=

# Frontend
NEXT_PUBLIC_API_URL=
