        {
          "name": "GET /sedes/mias (sedeId del dueño)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const sedes = pm.response.json();",
                  "pm.test('el dueño tiene al menos una sede', () => pm.expect(sedes).to.be.an('array').that.is.not.empty);",
                  "const centro = sedes.find((s) => s.nombre === 'Sede Centro') || sedes[0];",
                  "pm.environment.set('sedeId', centro.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDueno}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/sedes/mias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sedes",
                "mias"
              ]
            }
          }
        }
