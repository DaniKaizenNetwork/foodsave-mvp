    {
      "name": "API-06 Reservar descuenta inventario",
      "description": "SWR-RES-001, RES-002, RES-003, RES-005",
      "item": [
        {
          "name": "POST /reservas cantidad 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('estado RESERVADA y cantidad 2', () => { pm.expect(r.estado).to.eql('RESERVADA'); pm.expect(r.cantidad).to.eql(2); });",
                  "const creada = new Date(r.createdAt).getTime(), plazo = new Date(r.plazoRetiro).getTime();",
                  "pm.test('plazoRetiro <= createdAt + 12 h', () => pm.expect(plazo).to.be.at.most(creada + 12*3600*1000 + 1000));",
                  "pm.test('plazoRetiro <= vencimiento de la oferta', () => pm.expect(plazo).to.be.at.most(new Date(pm.environment.get('vencimiento')).getTime()));",
                  "pm.environment.set('reservaId', r.id);",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/ofertas?q=' + encodeURIComponent(pm.environment.get('productoNombre')), method: 'GET' }, (e, res) => {",
                  "  const o = res.json().find((x) => x.id === pm.environment.get('ofertaId'));",
                  "  pm.test('el inventario baja de 10 a 8', () => pm.expect(o.disponible).to.eql(8));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenConsumidor}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"ofertaId\":\"{{ofertaId}}\",\"cantidad\":2}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ]
            }
          }
        }
      ]
    },
