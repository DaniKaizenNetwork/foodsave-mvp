              "raw": "{\"sedeId\":\"{{sedeId}}\",\"producto\":\"{{productoPrecioMalo}}\",\"precioOriginal\":8000,\"precioOferta\":8000,\"cantidad\":10,\"vencimiento\":\"{{vencimiento}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ofertas",
