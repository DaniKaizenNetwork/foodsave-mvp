    {
      "name": "API-01 Login exitoso",
      "description": "SWR-AUTH-005",
      "item": [
        {
          "name": "POST /auth/login consumidor1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('devuelve accessToken (JWT)', () => pm.expect(j.accessToken).to.be.a('string').and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
                  "pm.test('usuario.rol = CONSUMIDOR', () => pm.expect(j.usuario.rol).to.eql('CONSUMIDOR'));",
                  "pm.test('usuario trae id y nombre', () => { pm.expect(j.usuario.id).to.be.a('string'); pm.expect(j.usuario.nombre).to.be.a('string'); });",
                  "pm.test('la respuesta no incluye contraseña ni hash', () => {",
                  "  const t = pm.response.text();",
                  "  pm.expect(t).to.not.match(/passwordHash|contrasena|password|\\$2[aby]\\$/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"correo\":\"consumidor1@foodsave.test\",\"contrasena\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "API-02 Login con contraseña incorrecta",
      "description": "SWR-AUTH-006",
      "item": [
        {
          "name": "POST /auth/login clave incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('código de error CREDENCIALES_INVALIDAS', () => pm.expect(pm.response.json().codigo).to.eql('CREDENCIALES_INVALIDAS'));",
                  "pm.test('mensaje exacto «Credenciales inválidas»', () => pm.expect(pm.response.json().mensaje).to.eql('Credenciales inválidas'));",
                  "pm.test('no devuelve accessToken', () => pm.expect(pm.response.json()).to.not.have.property('accessToken'));",
                  "pm.environment.set('mensajeClaveErrada', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"correo\":\"consumidor1@foodsave.test\",\"contrasena\":\"clave-incorrecta-postman\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "POST /auth/login correo inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('código de error CREDENCIALES_INVALIDAS', () => pm.expect(pm.response.json().codigo).to.eql('CREDENCIALES_INVALIDAS'));",
                  "pm.test('mensaje exacto «Credenciales inválidas»', () => pm.expect(pm.response.json().mensaje).to.eql('Credenciales inválidas'));",
                  "pm.test('respuesta idéntica a la de clave incorrecta (no revela si el correo existe)', () => pm.expect(pm.response.text()).to.eql(pm.environment.get('mensajeClaveErrada')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
