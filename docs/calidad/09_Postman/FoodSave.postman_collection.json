                  "pm.test('mensaje exacto «El precio de oferta debe ser menor al precio original»', () => pm.expect(pm.response.json().mensaje).to.eql('El precio de oferta debe ser menor al precio original'));",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/ofertas?q=' + encodeURIComponent(pm.environment.get('productoPrecioMalo')), method: 'GET' }, (e, r) => {",
