    {
      "name": "API-03 Consumidor no puede publicar",
      "description": "SWR-AUTH-010",
      "item": [
        {
          "name": "POST /ofertas con token de CONSUMIDOR",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('productoNombre', 'Pan Postman ' + Date.now());",
                  "pm.environment.set('productoNoCreado', 'Prohibido Postman ' + Date.now());",
                  "pm.environment.set('vencimiento', new Date(Date.now() + 24*3600*1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "pm.test('código de error PROHIBIDO', () => pm.expect(pm.response.json().codigo).to.eql('PROHIBIDO'));",
                  "pm.test('mensaje exacto «No tienes permiso para realizar esta acción»', () => pm.expect(pm.response.json().mensaje).to.eql('No tienes permiso para realizar esta acción'));",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/ofertas?q=' + encodeURIComponent(pm.environment.get('productoNombre')), method: 'GET' }, (e, r) => {",
                  "  pm.test('no se creó ninguna oferta', () => pm.expect(r.json().filter((o) => o.producto === pm.environment.get('productoNoCreado'))).to.be.empty);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenConsumidor}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"sedeId\":\"{{sedeId}}\",\"producto\":\"{{productoNoCreado}}\",\"precioOriginal\":8000,\"precioOferta\":4000,\"cantidad\":10,\"vencimiento\":\"{{vencimiento}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ofertas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ofertas"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "API-04 Publicar oferta (dueño)",
      "description": "SWR-OFE-001",
      "item": [
        {
          "name": "POST /ofertas válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test('estado ACTIVA', () => pm.expect(o.estado).to.eql('ACTIVA'));",
                  "pm.test('disponible = cantidad = 10', () => { pm.expect(o.cantidad).to.eql(10); pm.expect(o.disponible).to.eql(10); });",
                  "pm.test('precioOferta (4000) < precioOriginal (8000)', () => pm.expect(o.precioOferta).to.be.below(o.precioOriginal));",
                  "pm.test('pertenece a la sede indicada', () => pm.expect(o.sedeId).to.eql(pm.environment.get('sedeId')));",
                  "pm.environment.set('ofertaId', o.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDueno}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"sedeId\":\"{{sedeId}}\",\"producto\":\"{{productoNombre}}\",\"precioOriginal\":8000,\"precioOferta\":4000,\"cantidad\":10,\"vencimiento\":\"{{vencimiento}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ofertas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ofertas"
              ]
            }
          }
        }
      ]
    },
